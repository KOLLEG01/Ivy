{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivy.invalid/schemas/secretary.schema.json",
  "$defs": {
    "Pin": {
      "type": "object",
      "properties": {
        "objectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "objectId",
        "revision"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "secretaryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "rootObjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "secretaryId",
        "rootObjectId"
      ],
      "additionalProperties": false
    },
    "SourceDefinition": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "email",
            "teams",
            "whatsapp"
          ]
        },
        "producerPrincipalIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 16
        },
        "allowedSenderIds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 0,
              "maxItems": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "ownSenderIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "sourceId",
        "accountId",
        "kind",
        "producerPrincipalIds",
        "allowedSenderIds",
        "ownSenderIds"
      ],
      "additionalProperties": false
    },
    "Identity": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "serviceNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "scope",
        "principalId",
        "serviceNodeId",
        "hostId"
      ],
      "additionalProperties": false
    },
    "Policy": {
      "type": "object",
      "properties": {
        "silentTime": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "timeZone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "start": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "required": [
                "timeZone",
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "urgentBypass": {
          "type": "boolean"
        },
        "whatsappQuestionsOnly": {
          "type": "boolean"
        },
        "minimumMainUrgency": {
          "enum": [
            "normal",
            "high",
            "critical"
          ]
        },
        "researchMaxMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "voiceEscalation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "serviceNodeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "recipientId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "requestDefinitionHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "serviceNodeId",
                "recipientId",
                "requestDefinitionHash"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "silentTime",
        "urgentBypass",
        "whatsappQuestionsOnly",
        "minimumMainUrgency",
        "researchMaxMinutes",
        "voiceEscalation"
      ],
      "additionalProperties": false
    },
    "ExpectedBridge": {
      "type": "object",
      "properties": {
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "callerPrincipalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "definitionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "principalId",
        "callerPrincipalId",
        "workspaceId",
        "definitionHash"
      ],
      "additionalProperties": false
    },
    "Channel": {
      "type": "object",
      "properties": {
        "adapter": {
          "enum": [
            "webchat",
            "whatsapp"
          ]
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "channelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "adapter",
        "accountId",
        "channelId"
      ],
      "additionalProperties": false
    },
    "NoticeTarget": {
      "type": "object",
      "properties": {
        "serviceNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedBridge": {
          "$ref": "#/$defs/ExpectedBridge"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "notifyDefinitionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "noticeDefinitionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "serviceNodeId",
        "expectedBridge",
        "channel",
        "notifyDefinitionHash",
        "noticeDefinitionHash"
      ],
      "additionalProperties": false
    },
    "NotifyRequest": {
      "type": "object",
      "properties": {
        "action": {
          "const": "notify"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedBridge": {
          "$ref": "#/$defs/ExpectedBridge"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "source": {
          "$ref": "#/$defs/Pin"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "action",
        "operationId",
        "expectedBridge",
        "channel",
        "source",
        "text"
      ],
      "additionalProperties": false
    },
    "Settings": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceDefinition"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "noticeTarget": {
          "anyOf": [
            {
              "$ref": "#/$defs/NoticeTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "pollMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "recordsPerTick": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "followUpPrincipalIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "identity",
        "sources",
        "policy",
        "noticeTarget",
        "pollMs",
        "recordsPerTick"
      ],
      "additionalProperties": false
    },
    "ContactWindow": {
      "type": "object",
      "properties": {
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      },
      "required": [
        "timeZone",
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "ContactRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minimumUrgency": {
          "enum": [
            "normal",
            "high",
            "critical"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContactWindow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enabled",
        "minimumUrgency",
        "window"
      ],
      "additionalProperties": false
    },
    "WhatsAppRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minimumUrgency": {
          "enum": [
            "normal",
            "high",
            "critical"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContactWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "questionsOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "minimumUrgency",
        "window",
        "questionsOnly"
      ],
      "additionalProperties": false
    },
    "VoiceRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minimumUrgency": {
          "const": "critical"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContactWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "immediateOnly": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "minimumUrgency",
        "window",
        "immediateOnly"
      ],
      "additionalProperties": false
    },
    "GlobalRules": {
      "type": "object",
      "properties": {
        "main": {
          "$ref": "#/$defs/ContactRule"
        },
        "whatsapp": {
          "$ref": "#/$defs/WhatsAppRule"
        },
        "voice": {
          "$ref": "#/$defs/VoiceRule"
        },
        "researchMaxMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": [
        "main",
        "whatsapp",
        "voice",
        "researchMaxMinutes"
      ],
      "additionalProperties": false
    },
    "ContactRuleOverride": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minimumUrgency": {
          "enum": [
            "normal",
            "high",
            "critical"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContactWindow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "WhatsAppRuleOverride": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minimumUrgency": {
          "enum": [
            "normal",
            "high",
            "critical"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContactWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "questionsOnly": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "VoiceRuleOverride": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minimumUrgency": {
          "const": "critical"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContactWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "immediateOnly": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "RuleOverrides": {
      "type": "object",
      "properties": {
        "main": {
          "$ref": "#/$defs/ContactRuleOverride"
        },
        "whatsapp": {
          "$ref": "#/$defs/WhatsAppRuleOverride"
        },
        "voice": {
          "$ref": "#/$defs/VoiceRuleOverride"
        },
        "researchMaxMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ExecutionTarget": {
      "type": "object",
      "properties": {
        "serviceNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "threadCwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "permissions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "serviceNodeId",
        "threadCwd",
        "model",
        "effort",
        "permissions"
      ],
      "additionalProperties": false
    },
    "NativeTarget": {
      "type": "object",
      "properties": {
        "serviceNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeExecutableHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "catalogHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "serviceNodeId",
        "hostId",
        "nativeVersion",
        "nativeExecutableHash",
        "catalogHash"
      ],
      "additionalProperties": false
    },
    "SecretaryConfiguration": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "rules": {
          "$ref": "#/$defs/GlobalRules"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        }
      },
      "required": [
        "schemaVersion",
        "rules",
        "execution",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "ScheduleTrigger": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "schedule"
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cadence": {
          "enum": [
            "interval",
            "daily",
            "weekly"
          ]
        },
        "intervalMinutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10080
            },
            {
              "type": "null"
            }
          ]
        },
        "localTime": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "minItems": 0,
          "maxItems": 7
        }
      },
      "required": [
        "kind",
        "timeZone",
        "cadence",
        "intervalMinutes",
        "localTime",
        "weekdays"
      ],
      "additionalProperties": false
    },
    "EventTrigger": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "event"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "topicVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "sourceServiceNodeId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "eventKind": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "topic",
        "topicVersion",
        "sourceServiceNodeId",
        "eventKind"
      ],
      "additionalProperties": false
    },
    "AssignmentTrigger": {
      "oneOf": [
        {
          "$ref": "#/$defs/ScheduleTrigger"
        },
        {
          "$ref": "#/$defs/EventTrigger"
        }
      ]
    },
    "Preflight": {
      "type": "object",
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 64
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        }
      },
      "required": [
        "executable",
        "args",
        "timeoutMs"
      ],
      "additionalProperties": false
    },
    "AssignmentExecution": {
      "type": "object",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "effort": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reuse": {
          "enum": [
            "main",
            "assignment",
            "new"
          ]
        }
      },
      "required": [
        "model",
        "effort",
        "reuse"
      ],
      "additionalProperties": false
    },
    "Assignment": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "assignmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048
        },
        "enabled": {
          "type": "boolean"
        },
        "builtInKey": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ],
          "description": "Retained provenance metadata with no execution behavior. New assignments omit it."
        },
        "minimumNotificationAgeMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "trigger": {
          "$ref": "#/$defs/AssignmentTrigger"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072
        },
        "preflight": {
          "anyOf": [
            {
              "$ref": "#/$defs/Preflight"
            },
            {
              "type": "null"
            }
          ]
        },
        "rules": {
          "$ref": "#/$defs/RuleOverrides"
        },
        "execution": {
          "$ref": "#/$defs/AssignmentExecution"
        },
        "createdAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        }
      },
      "required": [
        "schemaVersion",
        "assignmentId",
        "name",
        "description",
        "enabled",
        "trigger",
        "prompt",
        "preflight",
        "rules",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "ExecutionTrigger": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "schedule",
            "event"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "occurredAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "payload": {}
      },
      "required": [
        "kind",
        "key",
        "occurredAt",
        "payload"
      ],
      "additionalProperties": false
    },
    "ScheduleProgress": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "assignmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assignment": {
          "$ref": "#/$defs/Pin"
        },
        "assignmentSnapshot": {
          "$ref": "#/$defs/Assignment"
        },
