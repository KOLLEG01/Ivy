{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true, "resolveJsonModule": true, "esModuleInterop": true,
    "skipLibCheck": true, "noEmit": true, "types": ["vite/client"]
  },
  "include": ["packages/ui/src/**/*.ts", "packages/ui/src/**/*.vue", "services/hive/console/**/*.ts", "services/hive/console/**/*.vue", "ui/**/*.ts", "ui/**/*.vue"]
}
