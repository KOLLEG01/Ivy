  "semanticTransitions": [
    { "from": "unbound", "action": "createMain", "guard": "exact expected revision and no pending action", "effect": "retain original native thread/start identity before dispatch; publish a binding only from its verified success" },
    { "from": "bound", "action": "send", "guard": "exact admitted sender/channel, unchanged binding, original payload identity, queue capacity", "effect": "CAS one admission intent; publish original input and queue ticket before acknowledging" },
    { "from": "delivering", "action": "lost native response", "guard": "original owner evidence unavailable", "effect": "outcome_unknown retains original call and blocks the next turn" },
    { "from": "pending reply", "action": "receive", "guard": "same admitted caller/channel and stable receive identity", "effect": "save original offered reply pins; unconfirmed delivery becomes outcome_unknown" },
    { "from": "outcome_unknown reply", "action": "acknowledge", "guard": "exact reply belongs to original caller's persisted offer", "effect": "confirmed once; replay does not emit another reply or native turn" },
    { "from": "bound with empty execution queue", "action": "createMain", "guard": "explicit replacement and expected Main revision", "effect": "retain previous binding and pending replies; publish new binding from original native outcome" }
  ]
