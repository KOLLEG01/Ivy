{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Pin": {
      "type": "object",
      "properties": {
        "objectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "objectId",
        "revision"
      ],
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outgoing": {
          "type": "boolean"
        },
        "attachments": {
          "enum": [
            "none",
            "expected"
          ]
        },
        "occurredAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32768
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "accountId",
        "conversationId",
        "messageId",
        "nativeRevision",
        "senderId",
        "outgoing",
        "attachments",
        "occurredAt",
        "observedAt",
        "title",
        "text",
        "url"
      ],
      "additionalProperties": false
    },
    "Assessment": {
      "type": "object",
      "properties": {
        "urgency": {
          "enum": [
            "low",
            "normal",
            "high",
            "critical"
          ]
        },
        "disposition": {
          "enum": [
            "ignore",
            "record",
            "notify",
            "task"
          ]
        },
        "notification": {
          "enum": [
            "none",
            "main",
            "voice",
            "needs_attention"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "question": {
          "type": "boolean"
        },
        "usefulIntel": {
          "type": "boolean"
        },
        "task": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "urgency",
        "disposition",
        "notification",
        "summary",
        "question",
        "usefulIntel",
        "task"
      ],
      "additionalProperties": false
    },
    "Identity": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "serviceNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "scope",
        "principalId",
        "serviceNodeId",
        "hostId"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "secretaryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "rootObjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "secretaryId",
        "rootObjectId"
      ],
      "additionalProperties": false
    },
    "Policy": {
      "type": "object",
      "properties": {
        "silentTime": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "timeZone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "start": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "required": [
                "timeZone",
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "urgentBypass": {
          "type": "boolean"
        },
        "whatsappQuestionsOnly": {
          "type": "boolean"
        },
        "minimumMainUrgency": {
          "enum": [
            "normal",
            "high",
            "critical"
          ]
        },
        "researchMaxMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "voiceEscalation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "serviceNodeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "recipientId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "requestDefinitionHash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "serviceNodeId",
                "recipientId",
                "requestDefinitionHash"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "silentTime",
        "urgentBypass",
        "whatsappQuestionsOnly",
        "minimumMainUrgency",
        "researchMaxMinutes",
        "voiceEscalation"
      ],
      "additionalProperties": false
    },
    "SourceDefinition": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "email",
            "teams",
            "whatsapp"
          ]
        },
        "producerPrincipalIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 16
        },
        "allowedSenderIds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 0,
              "maxItems": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "ownSenderIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "sourceId",
        "accountId",
        "kind",
        "producerPrincipalIds",
        "allowedSenderIds",
        "ownSenderIds"
      ],
      "additionalProperties": false
    },
    "NativeTarget": {
      "type": "object",
      "properties": {
        "serviceNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeExecutableHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "catalogHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "serviceNodeId",
        "hostId",
        "nativeVersion",
        "nativeExecutableHash",
        "catalogHash"
      ],
      "additionalProperties": false
    },
    "TriageSettings": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "target": {
          "$ref": "#/$defs/NativeTarget"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "threadCwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "maximumConcurrent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": [
        "schemaVersion",
        "target",
        "model",
        "effort",
        "instructions",
        "threadCwd",
        "maximumConcurrent"
      ],
      "additionalProperties": false
    },
    "TriageInput": {
      "type": "object",
      "properties": {
        "item": {
          "$ref": "#/$defs/Pin"
        },
        "source": {
          "$ref": "#/$defs/SourceDefinition"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "contentScope": {
          "enum": [
            "captured_text_or_caption",
            "verified_media"
          ]
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/TriageMedia"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        }
      },
      "required": [
        "item",
        "source",
        "message",
        "contentScope",
        "media",
        "policy"
      ],
      "additionalProperties": false
    },
    "TriageMediaAttachment": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "mediaType": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ]
        },
        "byteLength": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 33554432
            },
            {
              "type": "null"
            }
          ]
        },
        "contentHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "representation": {
          "enum": [
            "original_bytes",
            "rendered_preview"
          ]
        },
        "kind": {
          "enum": [
            "text",
            "image",
            "audio",
            "video",
            "unavailable"
          ]
        },
        "inputIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 352
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "mediaType",
        "manifest",
        "byteLength",
        "contentHash",
        "representation",
        "kind",
        "inputIndex",
        "errorCode"
      ],
      "additionalProperties": false
    },
    "TriageMedia": {
      "type": "object",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/Pin"
        },
        "coverageContract": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "coverageHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "gap": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TriageMediaAttachment"
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "coverage",
        "coverageContract",
        "coverageHash",
        "gap",
        "attachments"
      ],
      "additionalProperties": false
    },
    "TriageBinding": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "thread/start",
            "thread/resume",
            "turn/start",
            "thread/unsubscribe"
          ]
        },
        "definitionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "method",
        "definitionHash",
        "outputSchema"
      ],
      "additionalProperties": false
    },
    "TriagePlan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "settings": {
          "$ref": "#/$defs/TriageSettings"
        },
        "input": {
          "$ref": "#/$defs/TriageInput"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "promptHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "developerInstructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        },
        "nativeParams": {
          "$ref": "#/$defs/Pin"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TriageBinding"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "createdAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "settings",
        "input",
        "prompt",
        "promptHash",
        "developerInstructions",
        "outputSchema",
        "nativeParams",
        "bindings",
        "createdAt"
      ],
      "additionalProperties": false
    },
    "TriageThread": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ]
        },
        "threadId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "plan",
        "threadId"
      ],
      "additionalProperties": false
    },
    "TriageWork": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "item": {
          "$ref": "#/$defs/Pin"
        },
        "plan": {
          "$ref": "#/$defs/Pin"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "phase": {
          "enum": [
            "pending",
            "assessed",
            "superseded",
            "failed"
          ]
        },
        "completion": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ]
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "item",
        "plan",
        "operationId",
        "phase",
        "completion",
        "assessment",
        "errorCode"
      ],
      "additionalProperties": false
    },
    "TriageCall": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "plan": {
          "$ref": "#/$defs/Pin"
        },
        "slot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "method": {
          "enum": [
            "thread/start",
            "thread/resume",
            "turn/start",
            "thread/unsubscribe"
          ]
        },
        "request": {
          "$ref": "#/$defs/Pin"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "definitionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "preparedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "plan",
        "slot",
        "method",
        "request",
        "operationId",
        "definitionHash",
        "preparedAt",
        "observation"
      ],
      "additionalProperties": false
    },
    "TriageCompletion": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "plan": {
          "$ref": "#/$defs/Pin"
        },
        "turn": {
          "$ref": "#/$defs/Pin"
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "full": {
          "$ref": "#/$defs/Pin"
        },
        "verification": {
          "$ref": "#/$defs/Pin"
        },
        "result": {
          "$ref": "#/$defs/Assessment"
        },
        "completedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        }
      },
      "required": [
        "schemaVersion",
        "plan",
        "turn",
        "threadId",
        "turnId",
        "full",
        "verification",
        "result",
        "completedAt"
      ],
      "additionalProperties": false
    }
  }
}
