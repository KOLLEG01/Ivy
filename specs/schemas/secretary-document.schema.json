{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DocumentText": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "format", "representation", "sections", "limitations"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "format": { "enum": ["pdf", "docx", "html"] },
        "representation": { "const": "document_text" },
        "sections": { "type": "array", "minItems": 1, "maxItems": 128, "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "text"],
          "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 256 }, "text": { "type": "string", "maxLength": 6291456 } }
        } },
        "limitations": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "enum": ["visual_layout_not_interpreted", "embedded_media_not_interpreted", "external_resources_not_loaded", "pdf_annotations_and_forms_not_interpreted", "empty_pdf_pages"] } }
      }
    }
  }
}
