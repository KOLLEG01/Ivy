{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "OutlookCollector": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "target": {
          "$ref": "#/$defs/NativeTarget"
        },
        "expectedAccountHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "profile": {
          "$ref": "#/$defs/MicrosoftProfile"
        },
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "pollMs": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 86400000
        },
        "maximumPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "threadCwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "sourceId",
        "target",
        "expectedAccountHash",
        "profile",
        "since",
        "pageSize",
        "pollMs",
        "maximumPages",
        "threadCwd"
      ],
      "additionalProperties": false
    },
    "NativeTarget": {
      "type": "object",
      "properties": {
        "serviceNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeExecutableHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "catalogHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "serviceNodeId",
        "hostId",
        "nativeVersion",
        "nativeExecutableHash",
        "catalogHash"
      ],
      "additionalProperties": false
    },
    "MicrosoftProfile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "email"
      ],
      "additionalProperties": false
    },
    "MicrosoftBinding": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "account/read",
            "thread/start",
            "mcpServer/tool/call",
            "thread/unsubscribe"
          ]
        },
        "definitionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "method",
        "definitionHash",
        "outputSchema"
      ],
      "additionalProperties": false
    },
    "MediaPin": {
      "type": "object",
      "properties": {
        "objectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "objectId",
        "revision"
      ],
      "additionalProperties": false
    },
    "MediaAdmission": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "producerPrincipalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "providerMessageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "itemObjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "identityHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "messageHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "sourceId",
        "producerPrincipalId",
        "accountId",
        "providerMessageId",
        "itemObjectId",
        "identityHash",
        "messageHash"
      ],
      "additionalProperties": false
    },
    "MediaIntent": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "captureOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "item": {
          "$ref": "#/$defs/MediaPin"
        },
        "admission": {
          "$ref": "#/$defs/MediaAdmission"
        },
        "materializationHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "operationId",
        "captureOperationId",
        "item",
        "admission",
        "materializationHash"
      ],
      "additionalProperties": false
    },
    "MediaAttachment": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "attachmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "attachmentType": {
          "enum": [
            "fileAttachment",
            "itemAttachment",
            "referenceAttachment",
            "unknown"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "mediaType": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "providerSizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "inline": {
          "type": "boolean"
        },
        "contentId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "modifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "payloadFetchSupported": {
          "type": "boolean"
        }
      },
      "required": [
        "messageId",
        "attachmentId",
        "attachmentType",
        "name",
        "mediaType",
        "providerSizeBytes",
        "inline",
        "contentId",
        "modifiedAt",
        "payloadFetchSupported"
      ],
      "additionalProperties": false
    },
    "MediaMaterialization": {
      "type": "object",
      "properties": {
        "attachment": {
          "$ref": "#/$defs/MediaAttachment"
        },
        "fileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "downloadUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "nativeResponseHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "attachment",
        "fileId",
        "downloadUrl",
        "nativeResponseHash"
      ],
      "additionalProperties": false
    },
    "MediaDownloadEvidence": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "attachment": {
          "$ref": "#/$defs/MediaAttachment"
        },
        "fileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "materializationHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "downloadUrlHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "providerSizeRelation": {
          "enum": [
            "equal",
            "different"
          ]
        },
        "http": {
          "type": "object",
          "properties": {
            "status": {
              "const": 200
            },
            "contentLength": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 33554432
                },
                {
                  "type": "null"
                }
              ]
            },
            "contentEncoding": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            "contentType": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            },
            "contentMd5": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "contentLength",
            "contentEncoding",
            "contentType",
            "contentMd5"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "attachment",
        "fileId",
        "materializationHash",
        "downloadUrlHash",
        "startedAt",
        "observedAt",
        "byteLength",
        "contentHash",
        "providerSizeRelation",
        "http"
      ],
      "additionalProperties": false
    },
    "MediaManifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "admission": {
          "$ref": "#/$defs/MediaAdmission"
        },
        "evidence": {
          "$ref": "#/$defs/MediaDownloadEvidence"
        },
        "chunks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/MediaPin"
          }
        }
      },
      "required": [
        "schemaVersion",
        "admission",
        "evidence",
        "chunks"
      ],
      "additionalProperties": false
    },
    "MediaReadPlan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "admission": {
          "$ref": "#/$defs/MediaAdmission"
        },
        "item": {
          "$ref": "#/$defs/MediaPin"
        },
        "captureOperationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "configuration": {
          "$ref": "#/$defs/OutlookCollector"
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "bindings": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/MicrosoftBinding"
          }
        }
      },
      "required": [
        "schemaVersion",
        "admission",
        "item",
        "captureOperationId",
        "configuration",
        "epoch",
        "createdAt",
        "bindings"
      ],
      "additionalProperties": false
    },
    "MediaReadCall": {
      "type": "object",
      "properties": {
        "planHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 38
        },
        "method": {
          "enum": [
            "account/read",
            "thread/start",
            "mcpServer/tool/call",
            "thread/unsubscribe"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "definitionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "preparedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": [
        "planHash",
        "slot",
        "method",
        "params",
        "operationId",
        "definitionHash",
        "preparedAt"
      ],
      "additionalProperties": false
    },
    "MediaCallReceipt": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 38
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "method": {
          "enum": [
            "account/read",
            "thread/start",
            "mcpServer/tool/call",
            "thread/unsubscribe"
          ]
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "slot",
        "operationId",
        "method",
        "contentHash"
      ],
      "additionalProperties": false
    },
    "MediaCoverage": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "admission": {
          "$ref": "#/$defs/MediaAdmission"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "gap": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "attachments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "attachment": {
                "$ref": "#/$defs/MediaAttachment"
              },
              "manifest": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/MediaPin"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "errorCode": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "attachment",
              "manifest",
              "errorCode"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "admission",
        "observedAt",
        "gap",
        "attachments"
      ],
      "additionalProperties": false
    }
  }
}
