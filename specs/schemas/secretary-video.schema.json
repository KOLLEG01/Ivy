{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Executable": {
      "type": "object", "additionalProperties": false, "required": ["path", "hash"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 2048 }, "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
    },
    "VideoConfiguration": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "ffmpeg", "ffprobe"],
      "properties": { "schemaVersion": { "const": 1 }, "ffmpeg": { "$ref": "#/$defs/Executable" }, "ffprobe": { "$ref": "#/$defs/Executable" } }
    },
    "VideoProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "representation", "sourceHash", "decoderHash", "probeHash", "durationSeconds", "width", "height", "frames", "audio", "limitations"],
      "properties": {
        "schemaVersion": { "const": 1 }, "representation": { "const": "video_samples" },
        "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "decoderHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "probeHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 },
        "width": { "type": "integer", "minimum": 2, "maximum": 4096 }, "height": { "type": "integer", "minimum": 2, "maximum": 4096 },
        "frames": { "type": "array", "minItems": 1, "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["inputOffset", "sampleTimeSeconds", "contentHash"],
          "properties": { "inputOffset": { "type": "integer", "minimum": 1, "maximum": 8 }, "sampleTimeSeconds": { "type": "number", "minimum": 0, "maximum": 90 }, "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
        } },
        "audio": { "anyOf": [{ "type": "null" }, {
          "type": "object", "additionalProperties": false, "required": ["inputOffset", "sampleRate", "channels", "startTimeSeconds", "durationSeconds", "contentHash"],
          "properties": { "inputOffset": { "type": "integer", "minimum": 2, "maximum": 9 }, "sampleRate": { "const": 16000 }, "channels": { "const": 1 }, "startTimeSeconds": { "type": "number", "minimum": 0, "maximum": 90 }, "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 90 }, "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
        }] },
        "limitations": { "type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true,
          "items": { "enum": ["visual_frames_sampled", "images_resized", "subtitles_and_auxiliary_streams_not_interpreted", "audio_downmixed_and_resampled", "source_has_no_audio"] } }
      }
    }
  }
}
