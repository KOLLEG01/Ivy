{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RuntimeId": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 } },
    "Labels": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "Control": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parentId", "name", "enabled", "offscreen", "toggle"],
      "properties": {
        "id": { "$ref": "#/$defs/RuntimeId" }, "parentId": { "$ref": "#/$defs/RuntimeId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "enabled": { "type": "boolean" }, "offscreen": { "type": "boolean" },
        "toggle": { "type": ["integer", "null"], "minimum": 0, "maximum": 2 }
      }
    },
    "Window": {
      "type": "object", "additionalProperties": false,
      "required": ["handle", "minimized", "controls"],
      "properties": {
        "handle": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
        "minimized": { "type": "boolean" },
        "controls": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/Control" } }
      }
    },
    "Observation": {
      "type": "object", "additionalProperties": false, "required": ["state", "windows"],
      "properties": {
        "state": { "enum": ["observed", "unavailable"] },
        "windows": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/Window" } }
      },
      "if": { "properties": { "state": { "const": "unavailable" } } },
      "then": { "properties": { "windows": { "maxItems": 0 } } },
      "else": { "properties": { "windows": { "minItems": 1 } } }
    }
  }
}
