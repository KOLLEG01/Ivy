{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Message": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outgoing": {
          "type": "boolean"
        },
        "attachments": {
          "enum": [
            "none",
            "expected"
          ]
        },
        "occurredAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32768
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "accountId",
        "conversationId",
        "messageId",
        "nativeRevision",
        "senderId",
        "outgoing",
        "attachments",
        "occurredAt",
        "observedAt",
        "title",
        "text",
        "url"
      ],
      "additionalProperties": false
    },
    "Pin": {
      "type": "object",
      "properties": {
        "objectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "objectId",
        "revision"
      ],
      "additionalProperties": false
    },
    "SourceDefinition": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "email",
            "teams",
            "whatsapp"
          ]
        },
        "producerPrincipalIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 16
        },
        "allowedSenderIds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 0,
              "maxItems": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "ownSenderIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "sourceId",
        "accountId",
        "kind",
        "producerPrincipalIds",
        "allowedSenderIds",
        "ownSenderIds"
      ],
      "additionalProperties": false
    },
    "NativeTarget": {
      "type": "object",
      "properties": {
        "serviceNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeExecutableHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "catalogHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "serviceNodeId",
        "hostId",
        "nativeVersion",
        "nativeExecutableHash",
        "catalogHash"
      ],
      "additionalProperties": false
    },
    "MicrosoftProfile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "email"
      ],
      "additionalProperties": false
    },
    "OutlookSelection": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "until": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "skip": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "required": [
        "since",
        "until",
        "skip",
        "pageSize"
      ],
      "additionalProperties": false
    },
    "OutlookPage": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "selection": {
          "$ref": "#/$defs/OutlookSelection"
        },
        "nextIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          },
          "maxItems": 32
        },
        "excluded": {
          "type": "object",
          "properties": {
            "ownSender": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            },
            "senderNotAllowed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            }
          },
          "required": [
            "ownSender",
            "senderNotAllowed"
          ],
          "additionalProperties": false
        },
        "messagesWithAttachments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      },
      "required": [
        "schemaVersion",
        "sourceId",
        "accountId",
        "observedAt",
        "selection",
        "nextIndex",
        "complete",
        "messages",
        "excluded",
        "messagesWithAttachments"
      ],
      "additionalProperties": false
    },
    "OutlookCollector": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "target": {
          "$ref": "#/$defs/NativeTarget"
        },
        "expectedAccountHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "profile": {
          "$ref": "#/$defs/MicrosoftProfile"
        },
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "pollMs": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 86400000
        },
        "maximumPages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "threadCwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "sourceId",
        "target",
        "expectedAccountHash",
        "profile",
        "since",
        "pageSize",
        "pollMs",
        "maximumPages",
        "threadCwd"
      ],
      "additionalProperties": false
    },
    "MicrosoftConfiguration": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "collectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutlookCollector"
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "schemaVersion",
        "collectors"
      ],
      "additionalProperties": false
    },
    "OutlookContinuation": {
      "type": "object",
      "properties": {
        "selection": {
          "$ref": "#/$defs/OutlookSelection"
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10000
        }
      },
      "required": [
        "selection",
        "pageNumber"
      ],
      "additionalProperties": false
    },
    "OutlookHead": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "configuration": {
          "$ref": "#/$defs/OutlookCollector"
        },
        "source": {
          "$ref": "#/$defs/SourceDefinition"
        },
        "pending": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastPage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ]
        },
        "continuation": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutlookContinuation"
            },
            {
              "type": "null"
            }
          ]
        },
        "nextPollAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastCompleteAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "configuration",
        "source",
        "pending",
        "lastPage",
        "continuation",
        "nextPollAt",
        "lastCompleteAt"
      ],
      "additionalProperties": false
    },
    "MicrosoftBinding": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "account/read",
            "thread/start",
            "mcpServer/tool/call",
            "thread/unsubscribe"
          ]
        },
        "definitionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "method",
        "definitionHash",
        "outputSchema"
      ],
      "additionalProperties": false
    },
    "OutlookPlan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "head": {
          "$ref": "#/$defs/Pin"
        },
        "configuration": {
          "$ref": "#/$defs/OutlookCollector"
        },
        "source": {
          "$ref": "#/$defs/SourceDefinition"
        },
        "sourceCheckpoint": {
          "$ref": "#/$defs/Pin"
        },
        "previousCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "selection": {
          "$ref": "#/$defs/OutlookSelection"
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "preparedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MicrosoftBinding"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "schemaVersion",
        "head",
        "configuration",
        "source",
        "sourceCheckpoint",
        "previousCursor",
        "selection",
        "pageNumber",
        "epoch",
        "preparedAt",
        "bindings"
      ],
      "additionalProperties": false
    },
    "MicrosoftBlob": {
      "type": "object",
      "properties": {
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "byteLength",
        "contentHash",
        "chunks"
      ],
      "additionalProperties": false
    },
    "OutlookCall": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "plan": {
          "$ref": "#/$defs/Pin"
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "method": {
          "enum": [
            "account/read",
            "thread/start",
            "mcpServer/tool/call",
            "thread/unsubscribe"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "definitionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "preparedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "seen": {
          "anyOf": [
            {
              "$ref": "#/$defs/MicrosoftBlob"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/MicrosoftBlob"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "plan",
        "slot",
        "method",
        "params",
        "operationId",
        "definitionHash",
        "preparedAt",
        "seen",
        "observation"
      ],
      "additionalProperties": false
    },
    "OutlookEvidence": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "plan": {
          "$ref": "#/$defs/Pin"
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "minItems": 1,
          "maxItems": 7
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "gap": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "retryAfterSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            {
              "type": "null"
            }
          ]
        },
        "page": {
          "anyOf": [
            {
              "$ref": "#/$defs/OutlookPage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "plan",
        "calls",
        "observedAt",
        "gap",
        "retryAfterSeconds",
        "page"
      ],
      "additionalProperties": false
    },
    "OutlookPublication": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "evidence": {
          "$ref": "#/$defs/Pin"
        },
        "captured": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "evidence",
        "captured",
        "checkpoint"
      ],
      "additionalProperties": false
    }
  }
}
