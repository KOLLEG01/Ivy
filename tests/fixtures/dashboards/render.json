    "name": "opaque-sandbox",
    "html": "<script>dashboard.onUpdate(async()=>{let denied=0;try{parent.document.body; }catch{denied++}try{localStorage.getItem('x')}catch{denied++}try{document.cookie='x=secret';document.cookie}catch{denied++}try{await fetch('https://example.invalid/data')}catch{denied++}try{await new Promise((resolve,reject)=>{const ws=new WebSocket('wss://example.invalid/socket');ws.onopen=resolve;ws.onerror=reject;})}catch{denied++}try{await navigator.serviceWorker.register('https://example.invalid/worker.js')}catch{denied++}if(denied!==6)throw Error('sandbox '+denied);document.body.style.background='rgb(1,2,3)';});</script>",
