{
  "schemaVersion": 1,
  "componentId": "chat-bridge",
  "kind": "service",
  "version": "0.2.31",
  "description": "WhatsApp Main, native commands and durable notification delivery",
  "connectsToHive": true,
  "requirements": {
    "node": ">=24.18.0 <25.0.0",
    "hiveProtocol": 1,
    "contracts": []
  },
  "entrypoint": {
    "executable": "node",
    "args": [
      "dist/services/chat-bridge/src/main.js"
    ],
    "timeoutMs": 30000
  },
  "prepare": [
    {
      "executable": "node",
      "args": [
        "tools/build/run-npm.mjs",
        "ci"
      ],
      "timeoutMs": 600000
    },
    {
      "executable": "node",
      "args": [
        "--max-old-space-size=448",
        "tools/build/build-deployment.mjs",
        "--component",
        "chat-bridge"
      ],
      "timeoutMs": 300000
    }
  ],
  "checks": [],
  "readiness": {
    "timeoutMs": 60000,
    "command": {
      "executable": "node",
      "args": [
        "dist/packages/host-runtime/src/health.js"
      ],
      "timeoutMs": 5000
    }
  },
  "shutdown": {
    "timeoutMs": 15000
  },
  "restart": {
    "policy": "always",
    "minimumDelayMs": 1000,
    "maximumDelayMs": 60000
  },
  "storage": {
    "minReadableFormat": 1,
    "maxReadableFormat": 1,
    "writeFormat": 1
  },
  "runtimeReset": {
    "delete": [
      {
        "area": "data",
        "path": "chat-bridge.sqlite"
      },
      {
        "area": "data",
        "path": "chat-bridge.sqlite-wal"
      },
      {
        "area": "data",
        "path": "chat-bridge.sqlite-shm"
      },
      {
        "area": "data",
        "path": "whatsapp.sqlite"
      },
      {
        "area": "data",
        "path": "whatsapp.sqlite-wal"
      },
      {
        "area": "data",
        "path": "whatsapp.sqlite-shm"
      },
      {
        "area": "data",
        "path": "whatsapp-media"
      },
      {
        "area": "data",
        "path": "whatsapp-pairing.json"
      },
      {
        "area": "data",
        "path": "whatsapp-status.json"
      },
      {
        "area": "data",
        "path": "health.json"
      },
      {
        "area": "data",
        "path": "control.json"
      },
      {
        "area": "work",
        "path": "."
      },
      {
        "area": "logs",
        "path": "."
      }
    ],
    "preserve": [
      {
        "area": "data",
        "path": "whatsapp"
      }
    ]
  }
}
