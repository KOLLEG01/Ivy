{
  "schemaVersion": 1,
  "componentId": "hive",
  "kind": "hive",
  "version": "0.4.41",
  "description": "Persistent Hive backend and bundled Console",
  "connectsToHive": false,
  "requirements": {
    "node": ">=24.18.0 <25.0.0",
    "os": [
      "win32",
      "linux"
    ],
    "arch": [
      "x64",
      "arm64"
    ],
    "hiveProtocol": 1,
    "contracts": []
  },
  "entrypoint": {
    "executable": "dist/native/ivy-hive",
    "args": [],
    "timeoutMs": 30000
  },
  "prepare": [
    {
      "executable": "node",
      "args": [
        "tools/build/run-npm.mjs",
        "ci"
      ],
      "timeoutMs": 600000
    },
    {
      "executable": "node",
      "args": [
        "--max-old-space-size=448",
        "tools/build/build-deployment.mjs",
        "--component",
        "hive"
      ],
      "timeoutMs": 3600000
    }
  ],
  "checks": [],
  "readiness": {
    "timeoutMs": 180000,
    "command": {
      "executable": "dist/native/ivy-health",
      "args": [],
      "timeoutMs": 5000
    }
  },
  "shutdown": {
    "timeoutMs": 15000
  },
  "restart": {
    "policy": "always",
    "minimumDelayMs": 1000,
    "maximumDelayMs": 60000
  },
  "storage": {
    "minReadableFormat": 4,
    "maxReadableFormat": 4,
    "writeFormat": 4
  },
  "runtimeReset": {
    "delete": [
      { "area": "data", "path": "hive.sqlite.compacting" },
      { "area": "data", "path": "hive.sqlite.compacting-wal" },
      { "area": "data", "path": "hive.sqlite.compacting-shm" },
      { "area": "data", "path": "hive.sqlite.compacting-journal" },
      {
        "area": "data",
        "path": "hive.sqlite"
      },
      {
        "area": "data",
        "path": "hive.sqlite-wal"
      },
      {
        "area": "data",
        "path": "hive.sqlite-shm"
      },
      {
        "area": "data",
        "path": "ui-releases"
      },
      {
        "area": "data",
        "path": "health.json"
      },
      {
        "area": "data",
        "path": "control.json"
      },
      {
        "area": "data",
        "path": "runtime-reset-bootstrap.json"
      },
      {
        "area": "work",
        "path": "."
      },
      {
        "area": "logs",
        "path": "."
      }
    ],
    "preserve": []
  }
}
