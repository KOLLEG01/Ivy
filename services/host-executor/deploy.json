{
  "schemaVersion": 1,
  "componentId": "host-executor",
  "kind": "native",
  "version": "0.2.32",
  "description": "Independent host deployment executor with durable local recovery",
  "connectsToHive": false,
  "requirements": {
    "node": ">=24.18.0 <25.0.0",
    "hiveProtocol": null,
    "contracts": []
  },
  "entrypoint": {
    "executable": "node",
    "args": ["dist/packages/host-runtime/src/executor.js"],
    "timeoutMs": 30000
  },
  "prepare": [
    {
      "executable": "node",
      "args": ["tools/build/run-npm.mjs", "ci"],
      "timeoutMs": 600000
    },
    {
      "executable": "node",
      "args": [
        "--max-old-space-size=448",
        "tools/build/build-deployment.mjs",
        "--component",
        "host-executor"
      ],
      "timeoutMs": 300000
    }
  ],
  "checks": [],
  "readiness": {
    "timeoutMs": 30000,
    "command": {
      "executable": "node",
      "args": ["dist/packages/host-runtime/src/health.js"],
      "timeoutMs": 5000
    }
  },
  "shutdown": { "timeoutMs": 15000 },
  "restart": {
    "policy": "always",
    "minimumDelayMs": 1000,
    "maximumDelayMs": 60000
  },
  "storage": {
    "minReadableFormat": 1,
    "maxReadableFormat": 1,
    "writeFormat": 1
  },
  "runtimeReset": {
    "delete": [
      { "area": "host", "path": "deployments.sqlite" },
      { "area": "host", "path": "deployments.sqlite-wal" },
      { "area": "host", "path": "deployments.sqlite-shm" },
      { "area": "host", "path": "accepted-configurations" },
      { "area": "host", "path": "executor.json" },
      { "area": "host", "path": "guardians" },
      { "area": "host", "path": "host-configurations" },
      { "area": "host", "path": "instances" },
      { "area": "host", "path": "owners" },
      { "area": "host", "path": "preparation-progress" },
      { "area": "data", "path": "health.json" },
      { "area": "data", "path": "control.json" },
      { "area": "work", "path": "." },
      { "area": "logs", "path": "." }
    ],
    "preserve": [
      { "area": "host", "path": "bootstrap" },
      { "area": "host", "path": "bootstrap-plans" },
      { "area": "host", "path": "bootstrap-maintenance" },
      { "area": "host", "path": "bootstrap-automatic" }
    ]
  }
}
