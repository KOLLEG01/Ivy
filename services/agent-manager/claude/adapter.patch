@@ -0,0 +1,126 @@
+import { existsSync, readFileSync, renameSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { adapterHome, ensureParent } from './util.mjs'
+
+/** One subscription window: percent used (0-100), reset time in Unix seconds, observation time in ms. */
+interface Window {
+  usedPercent: number
+  resetsAt: number | null
+  observedAt: number
+  rejected?: boolean
+}
+type Windows = Record<string, Window>
+
+const WEEK_MINUTES = 7 * 24 * 60
+const LABELS: Record<string, string> = {
+  seven_day_opus: 'Weekly · Opus',
+  seven_day_sonnet: 'Weekly · Sonnet',
+  seven_day_oauth_apps: 'Weekly · OAuth apps',
+}
+
+const percent = (value: number): number => Math.min(100, Math.max(0, Math.round(value)))
+const seconds = (value: unknown): number | null => {
+  if (typeof value === 'number' && Number.isFinite(value)) return Math.round(value)
+  if (typeof value !== 'string') return null
+  const parsed = Date.parse(value)
+  return Number.isFinite(parsed) ? Math.round(parsed / 1000) : null
+}
+
+/**
+ * Claude reports subscription usage in `rate_limit_event` messages during turns and through the
+ * structured `/usage` data. The adapter keeps the latest value of every window on disk and serves
+ * it in the Codex `account/rateLimits/read` shape, so limits survive restarts and quiet periods.
+ */
+export class RateLimitStore {
+  private readonly path = join(adapterHome(), 'rate-limits.json')
+  private windows: Windows = {}
+  private usageAt = 0
+  constructor() {
+    try {
+      if (existsSync(this.path)) this.windows = JSON.parse(readFileSync(this.path, 'utf8')) as Windows
+    } catch {
+      this.windows = {}
+    }
+  }
+
+  /** Whether the on-demand `/usage` read is due; it runs at most once per interval. */
+  usageDue(now = Date.now(), intervalMs = 60_000): boolean {
+    return now - this.usageAt >= intervalMs
+  }
+
+  /** A `rate_limit_info` from a turn; its utilization is a fraction of the window. */
+  recordEvent(info: Record<string, unknown> | undefined, now = Date.now()): void {
+    const type = typeof info?.rateLimitType === 'string' ? info.rateLimitType : ''
+    if (!type || type === 'overage' || typeof info?.utilization !== 'number') return
+    this.save({
+      ...this.windows,
+      [type]: {
+        usedPercent: percent(info.utilization * 100),
+        resetsAt: seconds(info.resetsAt),
+        observedAt: now,
+        ...(info.status === 'rejected' ? { rejected: true } : {}),
+      },
+    })
+  }
+
+  /** The `rate_limits` of the structured `/usage` data; utilization is already a percentage. */
+  recordUsage(limits: Record<string, unknown> | null | undefined, now = Date.now()): void {
+    this.usageAt = now
+    if (!limits) return
+    const next: Windows = { ...this.windows }
+    const add = (key: string, value: unknown) => {
+      const window = value as { utilization?: unknown; resets_at?: unknown } | null | undefined
+      if (typeof window?.utilization !== 'number') return
+      next[key] = { usedPercent: percent(window.utilization), resetsAt: seconds(window.resets_at), observedAt: now }
+    }
+    for (const key of ['five_hour', 'seven_day', 'seven_day_opus', 'seven_day_sonnet', 'seven_day_oauth_apps'])
+      add(key, limits[key])
+    if (Array.isArray(limits.model_scoped))
+      for (const entry of limits.model_scoped as Array<{ display_name?: unknown }>)
+        if (typeof entry?.display_name === 'string' && entry.display_name)
+          add('model:' + entry.display_name, entry)
+    this.save(next)
+  }
+
+  /** The Codex response; a window whose reset has passed starts again at zero. */
+  read(nowSeconds = Math.floor(Date.now() / 1000)) {
+    const window = (key: string, minutes: number) => {
+      const value = this.windows[key]
+      if (!value) return null
+      const expired = value.resetsAt !== null && value.resetsAt <= nowSeconds
+      return { usedPercent: expired ? 0 : value.usedPercent, windowDurationMins: minutes, resetsAt: expired ? null : value.resetsAt }
+    }
+    const reached = Object.values(this.windows).some(
+      (value) => value.rejected && (value.resetsAt === null || value.resetsAt > nowSeconds),
+    )
+    const bucket = (limitId: string, limitName: string, primary: unknown, secondary: unknown = null) => ({
+      limitId,
+      limitName,
+      primary,
+      secondary,
+      credits: null,
+      planType: null,
+      rateLimitReachedType: reached && limitId === 'claude-code' ? ('rate_limit_reached' as const) : null,
+    })
+    const rateLimits = bucket('claude-code', 'Claude Code', window('five_hour', 300), window('seven_day', WEEK_MINUTES))
+    const byId: Record<string, ReturnType<typeof bucket>> = { 'claude-code': rateLimits }
+    for (const key of Object.keys(this.windows).sort()) {
+      if (key === 'five_hour' || key === 'seven_day') continue
+      const name = LABELS[key] ?? (key.startsWith('model:') ? 'Weekly · ' + key.slice(6) : null)
+      if (name) byId[key] = bucket(key, name, window(key, WEEK_MINUTES))
+    }
+    return { rateLimits, rateLimitsByLimitId: byId }
+  }
+
+  private save(next: Windows): void {
+    this.windows = next
+    try {
+      ensureParent(this.path)
+      const temporary = this.path + '.tmp'
+      writeFileSync(temporary, JSON.stringify(next) + '\n', { mode: 0o600 })
+      renameSync(temporary, this.path)
+    } catch {
+      // Usage remains available in memory when the adapter home is not writable.
+    }
+  }
+}
