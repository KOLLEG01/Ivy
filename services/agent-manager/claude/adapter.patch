@@ -0,0 +1,56 @@
+import type { RuntimeModel } from './types.mjs'
+
+/** Project only the CLI's current model and effort capabilities into the native picker. */
+export function runtimeModelList(
+  models: RuntimeModel[],
+  configuredModel: string,
+  configuredEffort: string,
+) {
+  const first = models[0]
+  if (!first) throw new Error('Claude CLI returned no available models')
+  const rows = new Map<string, RuntimeModel>()
+  const idOf = (model: RuntimeModel) =>
+    model.resolvedModel && !/\[.+\]$/.test(model.value) ? model.resolvedModel : model.value
+  const defaultId = idOf(
+    models.find((model) => model.value === configuredModel || idOf(model) === configuredModel) ??
+      models.find((model) => model.value === 'default') ??
+      first,
+  )
+  for (const model of models) {
+    const id = idOf(model)
+    if (!rows.has(id) || model.value !== 'default') rows.set(id, model)
+  }
+  return {
+    data: [...rows].map(([id, model]) => {
+      const efforts = model.supportsEffort === false ? [] : (model.supportedEffortLevels ?? [])
+      const version = /^claude-[a-z][a-z-]*-(\d+(?:-\d+)*)$/
+        .exec((model.resolvedModel ?? id).replace(/-\d{8}$/, ''))?.[1]
+        ?.replaceAll('-', '.')
+      return {
+        id,
+        model: id,
+        upgrade: null,
+        upgradeInfo: null,
+        availabilityNux: null,
+        displayName:
+          version && !model.displayName.includes(version)
+            ? `${model.displayName} ${version}`
+            : model.displayName,
+        description: model.description,
+        hidden: false,
+        supportedReasoningEfforts: efforts.map((reasoningEffort) => ({
+          reasoningEffort,
+          description: reasoningEffort,
+        })),
+        defaultReasoningEffort: efforts.includes(configuredEffort)
+          ? configuredEffort
+          : (efforts[0] ?? 'none'),
+        inputModalities: ['text', 'image'],
+        supportsPersonality: false,
+        additionalSpeedTiers: [],
+        isDefault: id === defaultId,
+      }
+    }),
+    nextCursor: null,
+  }
+}
