{
  "registry": {
    "discoveryHint": "AgentManager provides host readiness, capabilities and fallback access to Codex. Use a direct native Codex function first when it reaches the owning host.",
    "namespaces": [
      {
        "namespace": "codex",
        "description": "Codex tasks, projects, tools and integrations on this host",
        "guideMarkdown": "Use a direct native Codex function first when it reaches the host that owns the task or project; its typed arguments need no AgentManager discovery step. Use AgentManager for host capabilities and as fallback when a direct function cannot reach that owner. Discover the needed fallback method and use the exact returned native arguments and definition hash; available methods depend on the installed Codex version. Use thread/list and thread/read to inspect tasks, thread/start to create one and turn/start to send it work. Read-only methods need no outer operationId. For mutations, keep one outer operationId and inspect agent.operation after a lost reply. Pending inputs and approvals are handled through the agent namespace.",
        "tools": [],
        "discoveryGroups": [
          {
            "group": "codex",
            "description": "Native Codex operations using the selected host version."
          },
          {
            "group": "codex/tasks",
            "description": "Codex task lifecycle, content, settings and voice."
          },
          {
            "group": "codex/tasks/lifecycle",
            "description": "Create, find, resume, fork and archive Codex tasks."
          },
          {
            "group": "codex/tasks/content",
            "description": "Read task history, items and output."
          },
          {
            "group": "codex/tasks/settings",
            "description": "Task names, metadata, goals and configuration."
          },
          {
            "group": "codex/tasks/voice",
            "description": "Task realtime voice sessions and audio."
          },
          {
            "group": "codex/projects",
            "description": "Projects, workspaces and task organization."
          },
          {
            "group": "codex/turns",
            "description": "Start, steer and interrupt task turns and messages."
          },
          {
            "group": "codex/models-account",
            "description": "Models, account login and usage limits."
          },
          {
            "group": "codex/configuration",
            "description": "Settings, environments and permission profiles."
          },
          {
            "group": "codex/extensions",
            "description": "Plugins, MCP connections, marketplaces and skills."
          },
          {
            "group": "codex/files-commands",
            "description": "Native files, commands and processes."
          }
        ],
        "notifications": [],
        "topics": [],
