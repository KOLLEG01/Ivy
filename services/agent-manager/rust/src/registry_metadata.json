      {
        "namespace": "agent",
        "description": "Codex host readiness, work capabilities, outcomes and pending inputs",
        "discoveryGroups": [
          {
            "group": "agent",
            "description": "Check the Codex host, configure work capabilities and answer pending inputs."
          }
        ],
        "guideMarkdown": "Use a direct native Codex function first when it reaches the owning host; its typed arguments need no AgentManager discovery step. AgentManager supplies host capabilities and fallback access. Select a service node from the public tool schema, use agent_manager_status to read that node’s host, readiness and work capabilities, then use agent_manager_projects to read that host’s projects. Use agent_manager_discover to load an exact version-dependent native method. Pass its nativeVersion, method, expectedDefinitionHash and unchanged native params to agent_manager_invoke with a stable operationId. For pending input, use agent_manager_inputs for requests and their reply definitions, then submit agent_manager_answer to the same service node, connection epoch and request ID. Only the current owner can answer. Use agent_manager_read for fresh task state and original operation outcomes. Development-only direct interactions and notifications live on ivy_dev.",
        "tools": [
          {
            "namespace": "agent",
            "name": "status",
            "interfaceVersion": "1.0.0",
            "description": "Check this host’s Codex version, connection identity and operation capacity.",
            "discovery": {
              "mcp": {
                "name": "agent_manager_status",
                "surface": "ivy"
              },
              "keywords": [
                "Codex"
              ]
            },
            "inputSchema": {
              "$agentSchema": "StatusInput"
            },
            "outputSchema": {
              "$agentSchema": "Status"
            },
            "annotations": {
              "readOnlyHint": true,
              "idempotentHint": true
            }
          },
          {
            "namespace": "agent",
            "name": "catalog",
            "interfaceVersion": "1.0.0",
            "description": "Read the full installed Codex protocol catalog. Prefer agent_manager_discover for selected native methods; match this catalog’s hash to agent_manager_status.",
            "discovery": {
              "keywords": [
                "Codex"
              ]
            },
            "inputSchema": {
              "$agentSchema": "StatusInput"
            },
            "outputSchema": {
              "$agentSchema": "Catalog"
            },
            "annotations": {
              "readOnlyHint": true,
              "idempotentHint": true
            }
          },
          {
            "namespace": "agent",
            "name": "discover",
            "interfaceVersion": "1.0.0",
            "description": "Discover version-dependent native Codex methods on this host when native Codex tools cannot reach it. Omit query to list methods, search by query, or pass an exact method to load its input/output schemas and expectedDefinitionHash for agent_manager_invoke or agent_manager_interact.",
            "discovery": {
              "mcp": {
                "name": "agent_manager_discover",
                "surface": "ivy"
              },
              "keywords": [
                "Codex"
              ]
            },
            "inputSchema": {
              "$agentSchema": "NativeDiscoveryInput"
            },
            "outputSchema": {
              "$agentSchema": "NativeDiscovery"
            },
            "annotations": {
              "readOnlyHint": true,
              "idempotentHint": true
            }
          },
          {
            "namespace": "agent",
            "name": "frameLimits",
            "interfaceVersion": "1.0.0",
            "description": "Read request and response size limits for this Codex connection.",
            "discovery": {
              "keywords": [
                "Codex"
              ]
            },
            "inputSchema": {
              "$agentSchema": "FrameLimitsInput"
            },
            "outputSchema": {
              "$agentSchema": "FrameLimits"
            },
            "annotations": {
              "readOnlyHint": true,
              "idempotentHint": true
            }
          },
          {
            "namespace": "agent",
            "name": "operation",
            "interfaceVersion": "1.0.0",
            "description": "Check the original outcome of this caller’s Codex action by operationId.",
            "discovery": {
              "mcp": {
                "name": "agent_manager_read",
                "surface": "ivy"
              },
              "keywords": [
                "Codex"
              ]
            },
            "inputSchema": {
              "$agentSchema": "OperationInput"
            },
            "outputSchema": {
              "$agentSchema": "Operation"
            },
            "annotations": {
              "readOnlyHint": true,
              "idempotentHint": true
            }
          },
          {
            "namespace": "agent",
            "name": "invoke",
            "interfaceVersion": "1.0.0",
            "description": "Dispatch one idempotent native request and return its committed operation receipt.",
            "discovery": {
              "mcp": {
                "name": "agent_manager_invoke",
                "surface": "ivy"
              },
              "keywords": [
                "Codex"
              ]
            },
            "inputSchema": {
              "$agentSchema": "PreventInput"
            },
            "outputSchema": {
              "$agentSchema": "Operation"
            },
            "annotations": {
              "readOnlyHint": false,
              "idempotentHint": true
            }
          },
          {
            "namespace": "agent",
            "name": "interact",
            "interfaceVersion": "1.0.0",
            "description": "Send a direct native interaction without Hive persistence. Replies are cached briefly in this connection; use interaction lookup after uncertain delivery, never blindly replay mutations.",
            "discovery": {
              "mcp": {
                "name": "agent_manager_interact",
                "surface": "ivy_dev"
              },
              "keywords": [
                "Codex"
              ]
            },
            "inputSchema": {
              "$agentSchema": "PreventInput"
            },
            "outputSchema": {
              "$agentSchema": "Interaction"
            },
            "annotations": {
              "readOnlyHint": false,
              "idempotentHint": false
            }
          },
          {
            "namespace": "agent",
            "name": "interaction",
            "interfaceVersion": "1.0.0",
            "description": "Read a caller-scoped recent interaction reply. Expiry requires reconciliation against native thread state.",
            "discovery": {
              "mcp": {
                "name": "agent_manager_interaction",
                "surface": "ivy_dev"
              },
              "keywords": [
                "Codex"
              ]
            },
            "inputSchema": {
              "$agentSchema": "OperationInput"
            },
            "outputSchema": {
              "$agentSchema": "Interaction"
