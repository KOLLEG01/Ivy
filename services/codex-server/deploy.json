{
  "schemaVersion": 1,
  "componentId": "codex-server",
  "kind": "native",
  "version": "0.1.0",
  "description": "Host-managed shared Codex server with an independent process lifetime",
  "connectsToHive": false,
  "requirements": {
    "node": ">=24.18.0 <25.0.0",
    "os": [
      "win32"
    ],
    "arch": [
      "x64",
      "arm64"
    ],
    "hiveProtocol": null,
    "contracts": []
  },
  "entrypoint": {
    "executable": "dist/native/ivy-codex-server",
    "args": [],
    "timeoutMs": 30000
  },
  "prepare": [
    {
      "executable": "node",
      "args": [
        "tools/build/build-native-deployment.mjs",
        "--component",
        "codex-server"
      ],
      "timeoutMs": 3600000
    }
  ],
  "checks": [],
  "readiness": {
    "timeoutMs": 120000,
    "command": {
      "executable": "dist/native/ivy-health",
      "args": [],
      "timeoutMs": 5000
    }
  },
  "shutdown": {
    "timeoutMs": 15000
  },
  "restart": {
    "policy": "always",
    "minimumDelayMs": 1000,
    "maximumDelayMs": 60000
  },
  "storage": {
    "minReadableFormat": 1,
    "maxReadableFormat": 1,
    "writeFormat": 1
  }
}
