              "id",
              "expectedRevision"
            ],
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object"
          },
          "annotations": {
            "readOnlyHint": false,
            "idempotentHint": true
          },
          "discovery": {
            "mcp": {
              "name": "dashboard_delete",
              "surface": "ivy"
            }
          }
        },
        {
          "namespace": "dashboards",
          "name": "data",
          "interfaceVersion": "1.0.0",
          "description": "Read fresh data for the named Hive sources of a dashboard.",
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object"
          },
          "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
          }
        },
        {
          "namespace": "dashboards",
          "name": "render",
          "interfaceVersion": "1.0.0",
          "description": "Render fresh dashboard data as PNG at width/height (default 800×600). colorMode: color, grayscale (Gray8) or monochrome (strict black/white). Returns base64 PNG and metadata including refreshSeconds. HTML receives output.mode=image and dimensions/colorMode; async onUpdate is awaited.",
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "width": {
                "default": 800,
                "type": "integer",
                "minimum": 100,
                "maximum": 4096
              },
              "height": {
                "default": 600,
                "type": "integer",
                "minimum": 100,
                "maximum": 4096
              },
              "colorMode": {
                "default": "color",
                "type": "string",
                "enum": [
                  "color",
                  "grayscale",
                  "monochrome"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object"
          },
          "annotations": {
            "readOnlyHint": true,
            "idempotentHint": false
          },
          "discovery": {
            "mcp": {
              "name": "dashboard_render",
              "surface": "ivy"
            }
          }
        },
        {
          "namespace": "dashboards",
          "name": "image",
          "interfaceVersion": "1.0.0",
          "description": "Token-authorized PNG rendering for the public HTTP image endpoint. The token grants access to exactly one dashboard image.",
          "inputSchema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "width": {
                "default": 800,
                "type": "integer",
                "minimum": 100,
                "maximum": 4096
              },
              "height": {
                "default": 600,
                "type": "integer",
                "minimum": 100,
                "maximum": 4096
              },
              "colorMode": {
                "default": "color",
                "type": "string",
                "enum": [
                  "color",
                  "grayscale",
                  "monochrome"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "id",
              "token"
            ],
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object"
          },
          "annotations": {
            "readOnlyHint": true,
            "idempotentHint": true
          }
        }
      ],
