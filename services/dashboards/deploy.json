{
  "schemaVersion": 1,
  "componentId": "dashboards",
  "kind": "service",
  "version": "0.2.1",
  "description": "HTML dashboards with live Hive data and PNG rendering",
  "connectsToHive": true,
  "requirements": {
    "node": ">=24.18.0 <25.0.0",
    "os": [
      "win32",
      "linux"
    ],
    "arch": [
      "x64",
      "arm64"
    ],
    "hiveProtocol": 1,
    "contracts": []
  },
  "entrypoint": {
    "executable": "dist/native/ivy-dashboards",
    "args": [],
    "timeoutMs": 30000
  },
  "prepare": [
    {
      "executable": "node",
      "args": [
        "tools/build/run-npm.mjs",
        "ci"
      ],
      "timeoutMs": 600000
    },
    {
      "executable": "node",
      "args": [
        "--max-old-space-size=448",
        "tools/build/build-deployment.mjs",
        "--component",
        "dashboards"
      ],
      "timeoutMs": 3600000
    }
  ],
  "checks": [],
  "readiness": {
    "timeoutMs": 30000,
    "command": {
      "executable": "dist/native/ivy-health",
      "args": [],
      "timeoutMs": 5000
    }
  },
  "shutdown": {
    "timeoutMs": 15000
  },
  "restart": {
    "policy": "always",
    "minimumDelayMs": 1000,
    "maximumDelayMs": 60000
  },
  "storage": {
    "minReadableFormat": 1,
    "maxReadableFormat": 1,
    "writeFormat": 1
  }
}
