{
  "schemaVersion": 1,
  "componentId": "task-board",
  "kind": "service",
  "version": "0.2.71",
  "description": "Durable task actions, retained native Run reconciliation and fair scheduling",
  "connectsToHive": true,
  "requirements": {
    "node": ">=24.18.0 <25.0.0",
    "hiveProtocol": 1,
    "nativeCatalogs": true,
    "contracts": [],
    "os": ["win32", "linux"],
    "arch": ["x64", "arm64"]
  },
  "entrypoint": {
    "executable": "dist/native/ivy-task-board",
    "args": [],
    "timeoutMs": 30000
  },
  "prepare": [
    {
      "executable": "node",
      "args": [
        "tools/build/build-deployment.mjs",
        "--component",
        "task-board"
      ],
      "timeoutMs": 3600000
    }
  ],
  "checks": [],
  "readiness": {
    "timeoutMs": 30000,
    "command": {
      "executable": "dist/native/ivy-health",
      "args": [],
      "timeoutMs": 5000
    }
  },
  "shutdown": {
    "timeoutMs": 15000
  },
  "restart": {
    "policy": "always",
    "minimumDelayMs": 1000,
    "maximumDelayMs": 60000
  },
  "storage": {
    "minReadableFormat": 1,
    "maxReadableFormat": 1,
    "writeFormat": 1
  },
  "runtimeReset": {
    "delete": [
      {
        "area": "data",
        "path": "task-board.sqlite"
      },
      {
        "area": "data",
        "path": "task-board.sqlite-wal"
      },
      {
        "area": "data",
        "path": "task-board.sqlite-shm"
      },
      {
        "area": "data",
        "path": "health.json"
      },
      {
        "area": "data",
        "path": "control.json"
      },
      {
        "area": "work",
        "path": "."
      },
      {
        "area": "logs",
        "path": "."
      }
    ],
    "preserve": []
  }
}
