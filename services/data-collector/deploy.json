{
  "schemaVersion": 1,
  "componentId": "data-collector",
  "kind": "service",
  "version": "0.4.8",
  "description": "Isolated script tasks and versioned collection results",
  "connectsToHive": true,
  "requirements": {
    "node": ">=24.18.0 <25.0.0",
    "hiveProtocol": 1,
    "contracts": [],
    "os": [
      "win32",
      "linux"
    ],
    "arch": [
      "x64",
      "arm64"
    ]
  },
  "entrypoint": {
    "executable": "dist/native/ivy-data-collector",
    "args": [],
    "timeoutMs": 30000
  },
  "prepare": [
    {
      "executable": "node",
      "args": [
        "tools/build/build-native-deployment.mjs",
        "--component",
        "data-collector"
      ],
      "timeoutMs": 3600000
    }
  ],
  "checks": [],
  "readiness": {
    "timeoutMs": 60000,
    "command": {
      "executable": "dist/native/ivy-health",
      "args": [],
      "timeoutMs": 5000
    }
  },
  "shutdown": {
    "timeoutMs": 15000
  },
  "restart": {
    "policy": "always",
    "minimumDelayMs": 1000,
    "maximumDelayMs": 60000
  },
  "storage": {
    "minReadableFormat": 1,
    "maxReadableFormat": 1,
    "writeFormat": 1
  },
  "runtimeReset": {
    "delete": [
      {
        "path": "data-collector.sqlite",
        "area": "data"
      },
      {
        "path": "data-collector.sqlite-wal",
        "area": "data"
      },
      {
        "path": "data-collector.sqlite-shm",
        "area": "data"
      },
      {
        "path": "health.json",
        "area": "data"
      },
      {
        "path": "control.json",
        "area": "data"
      },
      {
        "path": "tasks",
        "area": "work"
      }
    ],
    "preserve": []
  }
}
