{
  "schemaVersion": 1,
  "componentId": "data-collector-ui",
  "kind": "app",
  "version": "0.1.12",
  "description": "DataCollector task editor and result viewer",
  "connectsToHive": false,
  "requirements": {
    "node": ">=24.18.0 <25.0.0",
    "hiveProtocol": 1,
    "contracts": []
  },
  "app": {
    "appId": "data-collector-ui",
    "dist": "dist/apps/data-collector-ui",
    "entryPath": "index.html"
  },
  "prepare": [
    {
      "executable": "node",
      "args": ["tools/build/run-npm.mjs", "ci"],
      "timeoutMs": 600000
    },
    {
      "executable": "node",
      "args": [
        "tools/build/build-deployment.mjs",
        "--component",
        "data-collector-ui"
      ],
      "timeoutMs": 300000
    }
  ],
  "checks": []
}
